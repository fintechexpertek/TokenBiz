    { email: 'admin@tokenbiz.io', label: 'Admin', role: 'ADMIN' },
    { email: 'john@greenenergy.com', label: 'Business (Verified)', role: 'BUSINESS' },
    { email: 'sarah@realtoken.io', label: 'Business (Under Review)', role: 'BUSINESS' },
    { email: 'alice@investor.com', label: 'Token Buyer', role: 'BUYER' },
