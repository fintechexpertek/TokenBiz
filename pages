                      if (user) {
                        dispatch({ type: 'LOGIN', payload: user });
                        toast({ title: `Signed in as ${user.firstName}`, description: `Role: ${acc.role}` });
                        if (user.role === 'ADMIN') navigate('/admin');
                        else if (user.role === 'BUSINESS') navigate('/dashboard/business');
                        else navigate('/dashboard/investor');
                      }
                    }}
                    className="flex items-center justify-between px-3 py-2 rounded-lg bg-secondary text-sm hover:bg-muted transition-colors"
